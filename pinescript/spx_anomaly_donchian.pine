//@version=5
strategy("SPX Index & Options Momentum Breakout Strategy", shorttitle="SPX Vol-Donchian", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=20, commission_type=strategy.commission.percent, commission_value=0.02, slippage=1, calc_on_every_tick=true)

// ============================================================================
// 1. SPX-CALIBRATED INPUT PARAMETERS
// ============================================================================
// Why SPX math differs from single NSE stocks:
//   1. Central Limit Theorem on Index Volume: SPY/SPX aggregates 500 stocks,
//      so volume variance is much tighter. A 1.35x RVOL / +1.6 sigma surge on
//      SPX is equivalent to a 2.5x+ surge on a single midcap stock.
//   2. Faster Intraday Structure: SPX momentum bursts run in 12-15 bar legs,
//      guided by institutional Session VWAP.
//   3. Quick In-and-Out Targets: SPX mean-reverts faster than single equities,
//      favoring tighter ATR stops (1.5x) and quick take-profit limits (2.2x).
grp_vol = "1. SPX Volume Anomaly Engine (Index-Calibrated)"
volWindow     = input.int(20,     "Volume Baseline Lookback (W)", minval=5, group=grp_vol)
minRvol       = input.float(1.35, "Minimum SPX RVOL (vs Median)", minval=1.0, step=0.05, group=grp_vol)
minZScore     = input.float(1.60, "Minimum SPX Log Z-Score (sigma)", minval=0.5, step=0.1, group=grp_vol)
useSameSlot   = input.bool(false, "Use Same-Slot Time-of-Day Baseline (Intraday)", group=grp_vol)
useSpyProxy   = input.bool(true,  "Auto-Use AMEX:SPY Volume on Cash SPX Index", group=grp_vol)

grp_don = "2. SPX Donchian + Institutional VWAP Filter"
donchianLen   = input.int(14,     "SPX Donchian Channel Length (N)", minval=5, group=grp_don)
minClv        = input.float(0.60, "Min Close Location Value (CLV 0..1)", minval=0.1, maxval=0.95, step=0.05, group=grp_don)
useVwapFilter = input.bool(true,  "Require Price Above/Below Session VWAP", group=grp_don)
allowShorts   = input.bool(true,  "Enable Short Breakdown Trades (SPX Puts / ES)", group=grp_don)

grp_risk = "3. Quick In-and-Out ATR Stop & Target (SPX Options)"
atrLen        = input.int(14,     "Wilder ATR Period", minval=5, group=grp_risk)
atrStopMult   = input.float(1.5,  "Initial Hard Stop (x ATR)", minval=0.5, step=0.25, group=grp_risk)
atrTrailMult  = input.float(1.8,  "Chandelier Trailing Stop (x ATR)", minval=0.5, step=0.25, group=grp_risk)
useTakeProfit = input.bool(true,  "Enable Quick In-and-Out Take-Profit Limit", group=grp_risk)
atrTargetMult = input.float(2.2,  "Quick Take-Profit Target (x ATR)", minval=0.5, step=0.25, group=grp_risk)
showHud       = input.bool(true,  "Show Live SPX Quantitative HUD Table", group=grp_risk)

// ============================================================================
// 2. VOLUME & VWAP RESOLUTION (AUTO-FALLBACK TO AMEX:SPY FOR SPX CASH INDEX)
// ============================================================================
[spyVol, spyHlc3] = request.security("AMEX:SPY", timeframe.period, [volume, hlc3], barmerge.gaps_off, barmerge.lookahead_off)
bool  usingProxy  = useSpyProxy and (na(volume) or volume <= 0)
float rawVol      = usingProxy ? nz(spyVol, 0.0) : nz(volume, 0.0)
float logVol      = math.log(1.0 + math.max(0.0, rawVol))

// Compute volume-weighted average price (VWAP) using SPY volume when on cash SPX
bool  isNewSession = ta.change(time("D")) != 0
var float cumPV    = 0.0
var float cumV     = 0.0
if isNewSession
    cumPV := hlc3 * rawVol
    cumV  := rawVol
else
    cumPV += hlc3 * rawVol
    cumV  += rawVol
float sessionVwap = cumV > 0 ? (cumPV / cumV) : close

// ============================================================================
// 3. OUTLIER-RESISTANT VOLUME MATH (INDEX-CALIBRATED)
// ============================================================================
var float[] slotVolArr = array.new_float(0)
var float[] slotLogArr = array.new_float(0)
var float[] absDevArr  = array.new_float(0)
array.clear(slotVolArr)
array.clear(slotLogArr)
array.clear(absDevArr)

int curH = hour(time)
int curM = minute(time)

if timeframe.isintraday and useSameSlot
    int maxLookback = math.min(bar_index, 1200)
    for k = 1 to maxLookback
        if hour(time[k]) == curH and minute(time[k]) == curM and rawVol[k] > 0
            array.push(slotVolArr, rawVol[k])
            array.push(slotLogArr, logVol[k])
            if array.size(slotVolArr) >= volWindow
                break

bool hasSlotHist = array.size(slotVolArr) >= 5

// Evaluate rolling `ta.*` series unconditionally on every bar for Pine consistency
float rollMedVol  = ta.median(rawVol[1], volWindow)
float rollLogMean = ta.sma(logVol[1], volWindow)
float rollLogStd  = ta.stdev(logVol[1], volWindow, false)
float rollLogMed  = ta.median(logVol[1], volWindow)

float baselineMedianVol = hasSlotHist ? array.median(slotVolArr) : rollMedVol
float rvol              = baselineMedianVol > 0 ? (rawVol / baselineMedianVol) : 1.0

float logMean = hasSlotHist ? array.avg(slotLogArr) : rollLogMean
float logStd  = hasSlotHist ? array.stdev(slotLogArr, false) : rollLogStd
float logZ    = logStd > 1e-9 ? (logVol - logMean) / logStd : 0.0

float logMed  = hasSlotHist ? array.median(slotLogArr) : rollLogMed
if hasSlotHist
    for idx = 0 to array.size(slotLogArr) - 1
        array.push(absDevArr, math.abs(array.get(slotLogArr, idx) - logMed))
else
    for i = 1 to volWindow
        array.push(absDevArr, math.abs(logVol[i] - logMed))

float logMad    = array.size(absDevArr) > 0 ? array.median(absDevArr) : 0.0
float modifiedZ = logMad > 1e-9 ? (0.67449 * (logVol - logMed)) / logMad : logZ

float effectiveZ   = math.max(logZ, modifiedZ)
bool  isVolAnomaly = barstate.isconfirmed and (rvol >= minRvol) and (effectiveZ >= minZScore)

// ============================================================================
// 4. SHIFTED DONCHIAN CHANNELS, VWAP FILTER, CLV & WILDER ATR
// ============================================================================
float donUpper = ta.highest(high, donchianLen)[1]
float donLower = ta.lowest(low, donchianLen)[1]
float donMid   = 0.5 * (donUpper + donLower)

float barRange = high - low
float clv      = barRange > 1e-9 ? (close - low) / barRange : 0.5
float atrVal   = ta.atr(atrLen)

bool vwapActive = useVwapFilter and timeframe.isintraday
bool vwapBullOk = not vwapActive or (close >= sessionVwap)
bool vwapBearOk = not vwapActive or (close <= sessionVwap)

bool longBreakout   = isVolAnomaly and (close > donUpper) and (clv >= minClv) and (close >= open) and vwapBullOk
bool shortBreakdown = isVolAnomaly and (close < donLower) and (clv <= (1.0 - minClv)) and (close <= open) and vwapBearOk

// ============================================================================
// 5. STRATEGY EXECUTION (QUICK IN-AND-OUT TARGET + TRAILING STOP)
// ============================================================================
var float activeStop   = na
var float activeTarget = na
var float highestClose = na
var float lowestClose  = na

if strategy.position_size == 0
    if longBreakout
        activeStop   := close - (atrStopMult * atrVal)
        activeTarget := useTakeProfit ? close + (atrTargetMult * atrVal) : na
        highestClose := close
        strategy.entry("SPX Call / Long", strategy.long, alert_message="SPX LONG BREAKOUT")
        strategy.exit("Long Exit", from_entry="SPX Call / Long", stop=activeStop, limit=activeTarget, alert_message="SPX LONG EXIT")
    else if allowShorts and shortBreakdown
        activeStop   := close + (atrStopMult * atrVal)
        activeTarget := useTakeProfit ? math.max(0.01, close - (atrTargetMult * atrVal)) : na
        lowestClose  := close
        strategy.entry("SPX Put / Short", strategy.short, alert_message="SPX SHORT BREAKDOWN")
        strategy.exit("Short Exit", from_entry="SPX Put / Short", stop=activeStop, limit=activeTarget, alert_message="SPX SHORT EXIT")
else if strategy.position_size > 0
    highestClose := math.max(nz(highestClose, close), close)
    float chandelierStop = highestClose - (atrTrailMult * atrVal)
    activeStop := math.max(nz(activeStop, chandelierStop), chandelierStop)
    strategy.exit("Long Exit", from_entry="SPX Call / Long", stop=activeStop, limit=activeTarget, alert_message="SPX LONG EXIT")
    if barstate.isconfirmed and close < donMid
        strategy.close("SPX Call / Long", comment="Close < DonMid", alert_message="SPX LONG MID EXIT")
else if strategy.position_size < 0
    lowestClose := math.min(nz(lowestClose, close), close)
    float chandelierStop = lowestClose + (atrTrailMult * atrVal)
    activeStop := math.min(nz(activeStop, chandelierStop), chandelierStop)
    strategy.exit("Short Exit", from_entry="SPX Put / Short", stop=activeStop, limit=activeTarget, alert_message="SPX SHORT EXIT")
    if barstate.isconfirmed and close > donMid
        strategy.close("SPX Put / Short", comment="Close > DonMid", alert_message="SPX SHORT MID EXIT")

// ============================================================================
// 6. VISUAL PLOTS (CLEAN STATUS LINE WITH `display=display.pane`) & LIVE HUD
// ============================================================================
pUpper = plot(donUpper, "Donchian Upper", color=color.new(#00e676, 25), linewidth=2)
pMid   = plot(donMid,   "Donchian Mid",   color=color.new(#ffab40, 35), linewidth=1, style=plot.style_circles)
pLower = plot(donLower, "Donchian Lower", color=color.new(#ff5252, 25), linewidth=2)
fill(pUpper, pLower, color=color.new(#007acc, 92), title="Donchian Channel Fill")

plot(timeframe.isintraday ? sessionVwap : na, "Session VWAP", color=color.new(#e040fb, 20), linewidth=2, display=display.pane)
plot(strategy.position_size != 0 ? activeStop : na, "Active Trailing Stop", color=color.new(#ff1744, 0), linewidth=2, style=plot.style_linebr, display=display.pane)
plot(strategy.position_size != 0 and useTakeProfit ? activeTarget : na, "Quick Profit Target", color=color.new(#00e676, 0), linewidth=2, style=plot.style_linebr, display=display.pane)

plotshape(longBreakout, title="Call / Long Breakout", style=shape.triangleup, location=location.belowbar, color=#00e676, size=size.small, text="CALL", display=display.pane)
plotshape(shortBreakdown, title="Put / Short Breakdown", style=shape.triangledown, location=location.abovebar, color=#ff5252, size=size.small, text="PUT", display=display.pane)
barcolor(longBreakout ? #00e676 : shortBreakdown ? #ff5252 : isVolAnomaly ? #40c4ff : na)

if showHud and barstate.islast
    var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(#18181c, 10), border_color=#333338, border_width=1)
    bool   isShortBias = shortBreakdown or strategy.position_size < 0
    string sigText = longBreakout ? "BUY CALL (LONG)" : shortBreakdown ? "BUY PUT (SHORT)" : isVolAnomaly ? "VOL EXPANSION" : "RANGE / WAIT"
    color  sigCol  = longBreakout ? #00e676 : shortBreakdown ? #ff5252 : isVolAnomaly ? #40c4ff : #aaaaaa
    float  hudStop = isShortBias ? (close + atrStopMult * atrVal) : (close - atrStopMult * atrVal)
    float  hudTgt  = isShortBias ? math.max(0.0, close - atrTargetMult * atrVal) : (close + atrTargetMult * atrVal)

    table.cell(hud, 0, 0, "SPX SIGNAL", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 0, sigText, text_color=sigCol, text_size=size.small)

    table.cell(hud, 0, 1, "VOL FEED / VWAP", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 1, (usingProxy ? "SPY Vol | " : "Chart Vol | ") + (close >= sessionVwap ? "Above VWAP" : "Below VWAP"), text_color=close >= sessionVwap ? #00e676 : #ff5252, text_size=size.small)

    table.cell(hud, 0, 2, "SPX RVOL (vs Med)", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(rvol, "#.##") + "x", text_color=rvol >= minRvol ? #00e676 : #ffffff, text_size=size.small)

    table.cell(hud, 0, 3, "Parametric Log-Z", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(logZ, "+#.##") + "s", text_color=logZ >= minZScore ? #00e676 : #ffffff, text_size=size.small)

    table.cell(hud, 0, 4, "Robust Log-MAD Z", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(modifiedZ, "+#.##") + "s", text_color=modifiedZ >= minZScore ? #00e676 : #ffffff, text_size=size.small)

    table.cell(hud, 0, 5, "Close Strength (CLV)", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 5, str.tostring(clv * 100, "#") + "%", text_color=clv >= minClv ? #00e676 : #ffffff, text_size=size.small)

    table.cell(hud, 0, 6, "Donchian (14) H / L", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(donUpper, "#.##") + " / " + str.tostring(donLower, "#.##"), text_color=#ffffff, text_size=size.small)

    table.cell(hud, 0, 7, "Stop (1.5ATR) / Tgt", text_color=#aaaaaa, text_size=size.small)
    table.cell(hud, 1, 7, str.tostring(hudStop, "#.##") + " / " + str.tostring(hudTgt, "#.##"), text_color=#ffab40, text_size=size.small)
